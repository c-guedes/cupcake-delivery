@startuml diagrama_casos_de_uso_final
!theme plain
left to right direction
skinparam linetype ortho
title Casos de Uso - Implementação Validada
actor Cliente
actor Entregador
actor Administrador
rectangle "Cupcake Delivery" {
  usecase "Cadastrar conta" as cadastro
  usecase "Fazer login" as login
  usecase "Visualizar catálogo" as catalogo
  usecase "Gerenciar carrinho local" as carrinho
  usecase "Criar pedido" as pedido
  usecase "Acompanhar pedidos" as acompanhar
  usecase "Ver e marcar notificações" as notificacoes
  usecase "Atualizar status para preparando/pronto" as statusAdmin
  usecase "Atualizar status para em entrega/entregue" as statusDelivery
  usecase "Gerenciar produtos" as produtos
  usecase "Alterar tema" as tema
}
Cliente --> cadastro
Cliente --> login
Cliente --> catalogo
Cliente --> carrinho
Cliente --> pedido
Cliente --> acompanhar
Cliente --> notificacoes
Cliente --> tema
Entregador --> cadastro
Entregador --> login
Entregador --> acompanhar
Entregador --> statusDelivery
Entregador --> notificacoes
Entregador --> tema
Administrador --> login
Administrador --> acompanhar
Administrador --> statusAdmin
Administrador --> produtos
Administrador --> notificacoes
Administrador --> tema
pedido ..> notificacoes : <<include>>
statusAdmin ..> notificacoes : <<include>>
statusDelivery ..> notificacoes : <<include>>
@enduml
