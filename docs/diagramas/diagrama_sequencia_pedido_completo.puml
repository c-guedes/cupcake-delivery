@startuml diagrama_sequencia_pedido_completo
!theme plain
title Sequência de Pedido - Implementação Validada
actor Cliente
actor Administrador
actor Entregador
participant "Frontend React" as F
participant "API Go/Gin" as API
participant "OrderHandler" as OH
participant "NotificationService" as NS
database PostgreSQL as DB
Cliente -> F : login
F -> API : POST /login
API --> F : JWT e perfil
Cliente -> F : finalizar pedido
F -> API : POST /orders (JWT, itens, endereço)
API -> OH : Create
OH -> DB : criar order e order_items
OH -> NS : NotifyOrderStatusChange(created)
NS -> DB : gravar notificações
API --> F : pedido pendente
Administrador -> API : PUT /orders/:id/status (preparing)
API -> OH : UpdateStatus
OH -> DB : atualizar pedido
OH -> NS : notificar cliente
Administrador -> API : PUT /orders/:id/status (ready)
OH -> DB : atualizar pedido
OH -> NS : notificar cliente e entregadores
Entregador -> API : PUT /orders/:id/status (delivering)
OH -> DB : atribuir entregador e atualizar pedido
OH -> NS : notificar cliente
Entregador -> API : PUT /orders/:id/status (delivered)
OH -> DB : atualizar pedido
OH -> NS : notificar cliente e administradores
@enduml
