{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite"
    },
    "api": {
      "root": "backend",
      "entrypoint": "cmd/api/main.go",
      "framework": "go"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/$1"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "api",
        "path": "/"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/images/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/login",
      "destination": {
        "service": "web",
        "path": "/"
      }
    },
    {
      "source": "/checkout",
      "destination": {
        "service": "web",
        "path": "/"
      }
    },
    {
      "source": "/signup/customer",
      "destination": {
        "service": "web",
        "path": "/"
      }
    },
    {
      "source": "/signup/delivery",
      "destination": {
        "service": "web",
        "path": "/"
      }
    },
    {
      "source": "/customer/(.*)",
      "destination": {
        "service": "web",
        "path": "/"
      }
    },
    {
      "source": "/delivery/(.*)",
      "destination": {
        "service": "web",
        "path": "/"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "web",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web",
        "path": "/"
      }
    }
  ]
}
